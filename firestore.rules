rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // /usernames/{username} → { uid, createdAt }
    // Used to reserve a unique public handle.
    match /usernames/{username} {
      allow get, list: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number
        && username.matches('^[a-z0-9_]{3,20}$');

      // No transfers / edits once claimed
      allow update, delete: if false;
    }

    // /pages/{uid} → full page config (owner-only write)
    match /pages/{uid} {
      allow get, list: if true;

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;

      allow delete: if isOwner(uid);
    }
  }
}
